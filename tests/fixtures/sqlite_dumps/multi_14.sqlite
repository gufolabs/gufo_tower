CREATE TABLE IF NOT EXISTS "node" ("id" INTEGER NOT NULL PRIMARY KEY, "environment_id" INTEGER NOT NULL, "datacenter_id" INTEGER NOT NULL, "name" VARCHAR(255) NOT NULL, "description" TEXT NOT NULL, "address" VARCHAR(255) NOT NULL, "login_as" VARCHAR(255) NOT NULL, "node_type_id" INTEGER REFERENCES "node_type" ("id") NOT NULL, "is_enabled" SMALLINT NOT NULL, FOREIGN KEY ("environment_id") REFERENCES "environment" ("id") ON DELETE RESTRICT, FOREIGN KEY ("datacenter_id") REFERENCES "datacenter" ("id") ON DELETE RESTRICT);
