CREATE TABLE IF NOT EXISTS "pulllog" ("id" INTEGER NOT NULL PRIMARY KEY, "start_ts" DATETIME NOT NULL, "complete_ts" DATETIME, "environment_id" INTEGER NOT NULL, "user" VARCHAR(255) NOT NULL, "repo" VARCHAR(255) NOT NULL, "status" SMALLINT NOT NULL, "log" TEXT NOT NULL, FOREIGN KEY ("environment_id") REFERENCES "environment" ("id"));
