  "noc-config-n01": {
    "hosts": [
      "n01"
    ],
    "vars": {
      "noc_services": [
        {
          "name": "chwriter",
          "config": {
            "batch_delay_ms": 1000,
            "batch_size": 50000,
            "channel_expire_interval": 300,
            "loglevel": "info",
            "power": 1,
            "records_buffer": 1000000
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/chwriter/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 10,
              "priority": 300,
              "startretries": 999,
              "stopwaitsecs": 2,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc",
              "clickhouse"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "datastream",
          "config": {
            "enable_address": false,
            "enable_address_wait": false,
            "enable_administrativedomain": false,
            "enable_administrativedomain_wait": false,
            "enable_alarm": false,
            "enable_alarm_wait": false,
            "enable_cfgping": true,
            "enable_cfgping_wait": true,
            "enable_cfgsyslog": true,
            "enable_cfgsyslog_wait": true,
            "enable_cfgtrap": true,
            "enable_cfgtrap_wait": true,
            "enable_dnszone": false,
            "enable_dnszone_wait": false,
            "enable_managedobject": false,
            "enable_managedobject_wait": false,
            "enable_prefix": false,
            "enable_prefix_wait": false,
            "enable_resourcegroup": false,
            "enable_resourcegroup_wait": false,
            "enable_vrf": false,
            "enable_vrf_wait": false,
            "loglevel": "info",
            "mode": "wait",
            "power": 1,
            "whitelist_access": ""
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/datastream/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 999,
              "priority": 100,
              "startretries": 999,
              "stopwaitsecs": 3,
              "stdout_logfile_maxbytes": "1MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc",
              "mongod"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "discovery",
          "config": {
            "backup_power": 1,
            "loglevel": "info",
            "max_threads": 20,
            "power": 2
          },
          "pool": "default",
          "environment": {
            "level": "pool",
            "category": "internal",
            "supervisord": {
              "command": "./services/discovery/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 500,
              "priority": 100,
              "startretries": 999,
              "stopwaitsecs": 3,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,yaml:///opt/noc/etc/pool-default.yml,env:///NOC"
        },
        {
          "name": "login",
          "config": {
            "language": "en",
            "loglevel": "info",
            "methods": "local",
            "pam_service": "noc",
            "power": 2,
            "radius_secret": null,
            "radius_server": null,
            "session_ttl": "7d"
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/login/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 10,
              "priority": 40,
              "startretries": 999,
              "stopwaitsecs": 3,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 5
            },
            "depends": [
              "noc"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "metrics",
          "config": {
            "backup_power": 1,
            "loglevel": "info",
            "power": 2
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/metrics/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 300,
              "priority": 50,
              "startretries": 999,
              "stopwaitsecs": 2,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "mib",
          "config": {
            "loglevel": "info",
            "power": 1
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/mib/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 100,
              "priority": 110,
              "startretries": 999,
              "stopwaitsecs": 3,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "sae",
          "config": {
            "db_threads": 4,
            "loglevel": "info",
            "power": 2
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/sae/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 300,
              "priority": 90,
              "startretries": 999,
              "stopwaitsecs": 1,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "scheduler",
          "config": {
            "loglevel": "info",
            "max_threads": 10,
            "power": 1
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/scheduler/service.py",
              "process_name": "%(program_name)s",
              "oom_score_adj": 100,
              "priority": 50,
              "startretries": 999,
              "stopwaitsecs": 3,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "depends": [
              "noc"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        },
        {
          "name": "web",
          "config": {
            "language": "en",
            "loglevel": "info",
            "max_threads": 10,
            "power": 2,
            "theme": "gray"
          },
          "pool": null,
          "environment": {
            "level": "global",
            "category": "internal",
            "supervisord": {
              "command": "./services/web/service.py",
              "process_name": "%(program_name)s-%(process_num)02d",
              "oom_score_adj": 300,
              "priority": 50,
              "startretries": 999,
              "stopwaitsecs": 2,
              "stdout_logfile_maxbytes": "10MB",
              "stdout_logfile_backups": 3
            },
            "required_assets": [
              "web",
              "mib"
            ],
            "depends": [
              "noc",
              "nginx"
            ]
          },
          "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC"
        }
      ]
    }
  },
