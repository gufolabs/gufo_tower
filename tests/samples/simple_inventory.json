{
  "all": {
    "vars": {
      "noc_env": "simple",
      "noc_installation_name": "Simple",
      "config_order": "yaml:///opt/noc/etc/tower.yml,yaml:///opt/noc/etc/settings.yml,env:///NOC",
      "installation_type": "test",
      "install_method": "git",
      "noc_env_type": "test",
      "playbook_link": "git+https://github.com/gufolabs/noc@stable",
      "noc_web_host": "simple.test.example.com",
      "tower_data": "${TMP}/cache/1/data",
      "tower_ssh_keys": "${TMP}/cache/1/ssh",
      "noc_all_pools": [
        {
          "name": "default",
          "description": "Default pool for simple"
        }
      ]
    }
  },
  "_meta": {
    "hostvars": {
      "n01": {
        "ansible_host": "10.0.0.1",
        "ansible_port": 22,
        "ansible_user": "ansible",
        "ansible_python_interpreter": "/usr/bin/python3",
        "ansible_ssh_private_key_file": "${TMP}/cache/1/ssh/deploy/id_ed25519",
        "node_id": 1,
        "noc_dc": "dc1",
        "ansible_ssh_pipelining": true,
        "ansible_connection": "ssh",
        "ansible_shell_type": "sh",
        "has_svc_discovery": true,
        "has_svc_mib": true,
        "has_svc_metrics": true,
        "has_svc_scheduler": true,
        "has_svc_login": true,
        "has_svc_kafka": true,
        "has_svc_postgres": true,
        "has_svc_nginx": true,
        "has_svc_mongod": true,
        "has_svc_sae": true,
        "has_svc_chwriter": true,
        "has_svc_clickhouse": true,
        "has_svc_datastream": true,
        "has_svc_web": true,
        "required_assets": [
          "bi",
          "card",
          "mib",
          "web"
        ]
      }
    }
  },
  "nodes": {
    "vars": {},
    "hosts": [
      "n01"
    ]
  },
  "dc-dc1": {
    "hosts": [
      "n01"
    ],
    "vars": {}
  },
